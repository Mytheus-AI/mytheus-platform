# mytheus-platform / env/prod.db.migrate.env - the SCHEMA OWNER credential and the one-time
# role passwords. Copy to env/prod.db.migrate.env and fill. NEVER commit the filled file.
#
# Layered on top of env/prod.env by the `migrate` one-shot service only. This is the most
# privileged file in the deploy and the whole reason the env files are split: no long-running
# process should be able to read it.
#
# The migrate step runs, in order:
#   alembic -c migrations/alembic.ini upgrade head
#   python -m scripts.bootstrap_roles
#
# Migration a1c4e7f20b18 creates mytheus_app / mytheus_relay / mytheus_admin with NO password,
# because a password in a migration is a password in git history. bootstrap_roles supplies
# them from the three variables below and refuses to finish if any of the three roles turns
# out to hold rolsuper or rolbypassrls.
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_strong_random@postgres:5432/mytheus
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_strong_random@postgres:5432/mytheus

MYTHEUS_APP_PASSWORD=CHANGE_ME_app_password
MYTHEUS_RELAY_PASSWORD=CHANGE_ME_relay_password
MYTHEUS_ADMIN_PASSWORD=CHANGE_ME_admin_password
