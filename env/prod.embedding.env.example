# env/prod.embedding.env - embedding-service, embedding-worker ONLY. The sole holder of the Qdrant
# WRITE key (same value as QDRANT__SERVICE__API_KEY in prod.qdrant.env). # NEVER commit the filled file (env/*.env is git-ignored; gitleaks enforces). Placeholders only.
QDRANT_API_KEY=CHANGE_ME_qdrant_WRITE_key
# Never-record index guard (polish plan): this service's entries in MYTHEUS_CORE_CALLER_TOKENS
# and MYTHEUS_BILLING_CALLER_TOKENS (prod.env), and the model key for the ambiguous-chunk check.
CORE_CALLER_TOKEN=
BILLING_SERVICE_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
