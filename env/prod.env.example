# mytheus-platform / env/prod.env  — PRODUCTION (self-hosted VPS).
# Copy to env/prod.env and fill. NEVER commit env/prod.env (only this .example). gitleaks enforces.
#
# Hostnames below (postgres/redis/redpanda) are the compose service names on the VPS network.
# PER-STORE SPLIT (confirm at deploy time): to use managed Supabase Postgres instead of the local
# `postgres` service, set DATABASE_URL to the Supabase pooled connection string and drop the
# `postgres` service from compose.prod.yml. Nothing else changes.

# --- Data stores (self-hosted) ---
#
# NO DATABASE CREDENTIAL LIVES IN THIS FILE. Every backend process reads it, so anything here
# is readable by all of them.
#
# Defect D1 had two halves. The application connected as `postgres`, which holds BYPASSRLS in
# supabase/postgres (the image's own migrations/10000000000000_demote-postgres.sql), so every
# tenant_isolation policy was inert; and this one file was handed to `migrate`, `web`, `relay`
# and `workflow` alike, so splitting the roles would have changed nothing while every process
# could still read every credential. Both halves are closed. The database URL now arrives from
# a per-role file layered on top of this one:
#
#   env/prod.db.app.env      -> web, workflow    (mytheus_app)
#   env/prod.db.relay.env    -> relay            (mytheus_relay)
#   env/prod.db.migrate.env  -> migrate          (schema owner + the one-time role passwords)
#
# THE STANDING RULE: never point DATABASE_URL at `postgres`, at a superuser, or at any role
# holding BYPASSRLS. It disables tenant isolation across the whole product and nothing fails
# loudly. Two CI assertions in mytheus-backend tests/test_roles_and_policies.py check the
# database side of this; they cannot see a deploy that hands the wrong URL to the right role.
POSTGRES_PASSWORD=CHANGE_ME_strong_random
POSTGRES_DB=mytheus
REDIS_URL=redis://redis:6379/0
REDPANDA_BROKERS=redpanda:29092
SCHEMA_REGISTRY_URL=http://redpanda:8081

# --- Temporal ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mytheus

# --- Identity (Clerk; RS256 JWKS + Svix webhooks) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Media (LiveKit) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# --- Edge / TLS ---
PUBLIC_HOSTNAME=srv1756037.hstgr.cloud

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Compose profiles (read by `docker compose`, i.e. the DEPLOY ENVIRONMENT, not by services) ---
# The intelligence / realtime / observability tiers are off unless enabled. Their images and
# secret files must exist first (see deploy/README.md "Optional tiers"). Example:
# COMPOSE_PROFILES=intelligence,realtime,observability
