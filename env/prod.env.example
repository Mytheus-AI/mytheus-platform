# mytheus-platform / env/prod.env  — PRODUCTION (self-hosted VPS).
# Copy to env/prod.env and fill. NEVER commit env/prod.env (only this .example). gitleaks enforces.
#
# Hostnames below (postgres/redis/redpanda) are the compose service names on the VPS network.
# PER-STORE SPLIT (confirm at deploy time): to use managed Supabase Postgres instead of the local
# `postgres` service, set DATABASE_URL to the Supabase pooled connection string and drop the
# `postgres` service from compose.prod.yml. Nothing else changes.

# --- Data stores (self-hosted) ---
#
# NO DATABASE CREDENTIAL LIVES IN THIS FILE. Every backend process reads it, so anything here
# is readable by all of them.
#
# Defect D1 had two halves. The application connected as `postgres`, which holds BYPASSRLS in
# supabase/postgres (the image's own migrations/10000000000000_demote-postgres.sql), so every
# tenant_isolation policy was inert; and this one file was handed to `migrate`, `web`, `relay`
# and `workflow` alike, so splitting the roles would have changed nothing while every process
# could still read every credential. Both halves are closed. The database URL now arrives from
# a per-role file layered on top of this one:
#
#   env/prod.db.app.env      -> web, workflow    (mytheus_app)
#   env/prod.db.relay.env    -> relay            (mytheus_relay)
#   env/prod.db.migrate.env  -> migrate          (schema owner + the one-time role passwords)
#
# THE STANDING RULE: never point DATABASE_URL at `postgres`, at a superuser, or at any role
# holding BYPASSRLS. It disables tenant isolation across the whole product and nothing fails
# loudly. Two CI assertions in mytheus-backend tests/test_roles_and_policies.py check the
# database side of this; they cannot see a deploy that hands the wrong URL to the right role.
POSTGRES_PASSWORD=CHANGE_ME_strong_random
POSTGRES_DB=mytheus
REDIS_URL=redis://redis:6379/0
REDPANDA_BROKERS=redpanda:29092
SCHEMA_REGISTRY_URL=http://redpanda:8081

# --- Temporal ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mytheus

# --- Identity (Clerk; RS256 JWKS + Svix webhooks) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Media (LiveKit) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# --- Edge / TLS ---
PUBLIC_HOSTNAME=srv1756037.hstgr.cloud

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Compose profiles (read by `docker compose`, i.e. the DEPLOY ENVIRONMENT, not by services) ---
# The intelligence / realtime / observability tiers are off unless enabled. Their images and
# secret files must exist first (see deploy/README.md "Optional tiers"). Example:
# COMPOSE_PROFILES=intelligence,realtime,observability

# --- Key custody (mytheus-docs ADR-0026) ---
#
# NOT set in this file: prod.env is read by every backend process, and only
# identity-tenant-service holds the key. compose.prod.yml sets these on that one service:
#   MYTHEUS_KEY_CUSTODY=local-file
#   MYTHEUS_KEK_FILE=/run/secrets/mytheus_kek
#   MYTHEUS_BLIND_INDEX_KEY_FILE=/run/secrets/mytheus_blind_index_key
# Host side: $MYTHEUS_KEYS_DIR (default /etc/dokploy/mytheus-secrets/keys)/mytheus_kek and
# /mytheus_blind_index_key, each base64 of 32 random bytes, mode 0400, owner uid 10001.
# NEVER put MYTHEUS_KEK_BASE64 / MYTHEUS_BLIND_INDEX_KEY_BASE64 here: local-file custody
# refuses to start if a key value is present in the environment.
# Back both files up OFF-BOX, separately from database backups: losing the KEK makes every
# oauth_tokens and pii_tokens row unrecoverable.
# Polish plan wave 1 (reach). bff reads its own `bff=` entry of MYTHEUS_RAG_CALLER_TOKENS (the
# same entry rag-service accepts, prod.rag.env) for POST /api/v1/ask and the MCP ask tool.
MYTHEUS_RAG_CALLER_TOKENS=bff=CHANGE_ME
RAG_SERVICE_URL=http://rag-service:8107
# core-api -> notification-service (email deliveries, meeting follow-ups): `core-api=` entry.
MYTHEUS_NOTIFICATION_CALLER_TOKENS=core-api=CHANGE_ME
NOTIFICATION_SERVICE_URL=http://notification-service:8000
# Optional; derived from GATEWAY_SIGNING_KEY when unset.
SHARE_LINK_SIGNING_KEY=
# Not connected until set: email (EMAIL_PROVIDER=resend, RESEND_API_KEY, EMAIL_FROM), and the
# HubSpot / Notion / Confluence OAuth apps.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
# Polish wave 3. core-api mints the phone's in-person capture tokens with the same secret as
# transcription-service and the web app (scripts/push-secrets.sh polish sets all three).
CAPTURE_TOKEN_SECRET=
CAPTURE_INGEST_URL=wss://api.mytheus.cloud/capture/audio
# Push to phones (notification consumer): off until set to `expo`. EXPO_ACCESS_TOKEN only if the
# Expo project enforces push security.
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
# Recording playback (not connected until set): meeting-service records to the mytheus-recordings
# bucket (R2) only with RECORDING_ENABLED=true and the S3_* recording credentials; core-api's
# `core-api=` entry in MYTHEUS_MEETING_CALLER_TOKENS lets it pause, erase and cut clips.
RECORDING_ENABLED=
RECORDING_URL_TTL_SECONDS=600
