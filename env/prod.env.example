# mytheus-platform / env/prod.env  — PRODUCTION (self-hosted VPS).
# Copy to env/prod.env and fill. NEVER commit env/prod.env (only this .example). gitleaks enforces.
#
# Hostnames below (postgres/redis/redpanda) are the compose service names on the VPS network.
# PER-STORE SPLIT (confirm at deploy time): to use managed Supabase Postgres instead of the local
# `postgres` service, set DATABASE_URL to the Supabase pooled connection string and drop the
# `postgres` service from compose.prod.yml. Nothing else changes.

# --- Data stores (self-hosted) ---
#
# BLOCKING WARNING - defect D1. DO NOT DEPLOY WITH THIS DATABASE_URL.
# `postgres` holds BYPASSRLS in supabase/postgres (granted by the image's own
# migrations/10000000000000_demote-postgres.sql). Row-level security does not apply to it,
# so every tenant-isolation guarantee in this product is inert on this connection. Worse,
# compose.prod.yml's x-backend anchor shares one env_file across `migrate`, `web`, `relay`
# and `workflow`, so all four inherit it.
# Section 3.3 creates mytheus_app / mytheus_relay / mytheus_admin, none holding BYPASSRLS or
# rolsuper, splits the env_file per role, and the application stops using `postgres`.
# Until that lands, this file is for a stack holding NO real tenant data.
POSTGRES_PASSWORD=CHANGE_ME_strong_random
POSTGRES_DB=mytheus
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_strong_random@postgres:5432/mytheus
REDIS_URL=redis://redis:6379/0
REDPANDA_BROKERS=redpanda:29092
SCHEMA_REGISTRY_URL=http://redpanda:8081

# --- Temporal ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mytheus

# --- Identity (Clerk; RS256 JWKS + Svix webhooks) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Media (LiveKit) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# --- Edge / TLS ---
PUBLIC_HOSTNAME=srv1756037.hstgr.cloud

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
