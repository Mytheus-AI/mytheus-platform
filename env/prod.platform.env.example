# mytheus-platform / env/prod.platform.env - shared NON-SECRET topology for the intelligence and
# realtime tiers (deploy/compose.prod.yml). Deliberately separate from prod.env so these services
# never receive Clerk/Stripe/LiveKit secrets. # NEVER commit the filled file (env/*.env is git-ignored; gitleaks enforces). Placeholders only.
REDIS_URL=redis://redis:6379/0
REDPANDA_BROKERS=redpanda:29092
SCHEMA_REGISTRY_URL=http://redpanda:8081
QDRANT_URL=http://qdrant:6333
OTEL_EXPORTER_OTLP_ENDPOINT=

# Object storage is Cloudflare R2 (ADR-0023): NO MinIO in prod. Endpoint/bucket are not secret;
# the credential lives in prod.ingestion.env. Region for R2 is 'auto'.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_DOCUMENTS=nexus-documents
# The intelligence code still reads the MINIO_* name (libs/shared/object_storage.py):
MINIO_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
