# mytheus-platform / env/staging.env  — STAGING (same shape as prod, separate secrets + hostname).
# Copy to env/staging.env and fill. NEVER commit the filled file.

# Defect D1 is closed: the application connects as `mytheus_app`, which holds neither
# rolsuper nor rolbypassrls. `postgres` is the schema owner and runs migrations only. Never
# point DATABASE_URL back at it. See prod.env.example for the full note.
POSTGRES_PASSWORD=CHANGE_ME_staging
POSTGRES_DB=mytheus

DATABASE_URL=postgresql+asyncpg://mytheus_app:CHANGE_ME_app_password@postgres:5432/mytheus
RELAY_DATABASE_URL=postgresql+asyncpg://mytheus_relay:CHANGE_ME_relay_password@postgres:5432/mytheus
ADMIN_DATABASE_URL=postgresql+asyncpg://mytheus_admin:CHANGE_ME_admin_password@postgres:5432/mytheus
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_staging@postgres:5432/mytheus

# migrate step only.
MYTHEUS_APP_PASSWORD=CHANGE_ME_app_password
MYTHEUS_RELAY_PASSWORD=CHANGE_ME_relay_password
MYTHEUS_ADMIN_PASSWORD=CHANGE_ME_admin_password

REDIS_URL=redis://redis:6379/0
REDPANDA_BROKERS=redpanda:29092
SCHEMA_REGISTRY_URL=http://redpanda:8081

TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mytheus

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

PUBLIC_HOSTNAME=staging.example.com

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
