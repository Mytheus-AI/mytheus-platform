# mytheus-platform / env/staging.env  — STAGING (same shape as prod, separate secrets + hostname).
# Copy to env/staging.env and fill. NEVER commit the filled file.

# WARNING - defect D1. `postgres` holds BYPASSRLS in supabase/postgres, so row-level
# security does not apply to this connection and no tenant-isolation guarantee holds.
# Section 3.3 replaces it with mytheus_app / mytheus_relay / mytheus_admin. See
# prod.env.example for the full note.
POSTGRES_PASSWORD=CHANGE_ME_staging
POSTGRES_DB=mytheus
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_staging@postgres:5432/mytheus
REDIS_URL=redis://redis:6379/0
REDPANDA_BROKERS=redpanda:29092
SCHEMA_REGISTRY_URL=http://redpanda:8081

TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mytheus

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

PUBLIC_HOSTNAME=staging.example.com

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
