# env/prod.search.env - search-service, search-worker, knowledge-graph-service. Qdrant READ-ONLY
# key only (same value as QDRANT__SERVICE__READ_ONLY_API_KEY). NEVER put the write key here. # NEVER commit the filled file (env/*.env is git-ignored; gitleaks enforces). Placeholders only.
QDRANT_READ_ONLY_API_KEY=CHANGE_ME_qdrant_READ_key
# Never-record index guard (polish plan): this service's entries in MYTHEUS_CORE_CALLER_TOKENS
# and MYTHEUS_BILLING_CALLER_TOKENS (prod.env), and the model key for the ambiguous-chunk check.
CORE_CALLER_TOKEN=
BILLING_SERVICE_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
