# env/prod.qdrant.env - read ONLY by the qdrant container (server-side keys). # NEVER commit the filled file (env/*.env is git-ignored; gitleaks enforces). Placeholders only.
# Two DIFFERENT keys (libs/shared/qdrant.py refuses identical ones). Mirror in the files below.
QDRANT__SERVICE__API_KEY=CHANGE_ME_qdrant_WRITE_key
QDRANT__SERVICE__READ_ONLY_API_KEY=CHANGE_ME_qdrant_READ_key
