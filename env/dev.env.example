# mytheus-platform / env/dev.env  — LOCAL DEV. Points at the docker-compose stack in mytheus-backend
# (localhost ports). Copy to env/dev.env and fill the provider keys you need. Never commit the file.

POSTGRES_PASSWORD=postgres
POSTGRES_DB=mytheus
# Ports match mytheus-backend/docker-compose.yml, which publishes 5433/6380 so the stack
# never collides with another local Postgres or Redis.
#
# WARNING - defect D1. `postgres` is the role the application connects as, and in
# supabase/postgres it holds BYPASSRLS (the image's own demote-postgres migration grants
# it). Row-level security therefore does NOT apply to this connection, so no tenant
# isolation guarantee holds for anything using this URL. Section 3.3 introduces
# mytheus_app / mytheus_relay / mytheus_admin, none holding BYPASSRLS or rolsuper, and the
# application stops using `postgres`. Until then, treat every isolation claim as unproven.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mytheus
REDIS_URL=redis://localhost:6380/0
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mytheus

# Clerk / Stripe / LiveKit — fill with test-mode keys as needed for the feature you are running.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

PUBLIC_HOSTNAME=:80

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
