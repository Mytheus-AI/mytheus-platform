# mytheus-platform / env/dev.env  — LOCAL DEV. Points at the docker-compose stack in mytheus-backend
# (localhost ports). Copy to env/dev.env and fill the provider keys you need. Never commit the file.

POSTGRES_PASSWORD=postgres
POSTGRES_DB=mytheus
# Ports match mytheus-backend/docker-compose.yml, which publishes 5443/6390 so the stack
# never collides with another local Postgres or Redis.
#
# Defect D1 is closed: the application connects as `mytheus_app`, which holds neither
# rolsuper nor rolbypassrls and is therefore subject to every tenant_isolation policy.
# `postgres` is now only the schema owner that runs migrations. Never point DATABASE_URL back
# at it: it holds BYPASSRLS in supabase/postgres, and doing so disables tenant isolation
# everywhere at once with nothing failing loudly.
#
# Run `make dev` in mytheus-backend once to create the roles and set these dev passwords.
DATABASE_URL=postgresql+asyncpg://mytheus_app:mytheus_app@localhost:5443/mytheus
RELAY_DATABASE_URL=postgresql+asyncpg://mytheus_relay:mytheus_relay@localhost:5443/mytheus
ADMIN_DATABASE_URL=postgresql+asyncpg://mytheus_admin:mytheus_admin@localhost:5443/mytheus
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5443/mytheus
MYTHEUS_APP_PASSWORD=mytheus_app
MYTHEUS_RELAY_PASSWORD=mytheus_relay
MYTHEUS_ADMIN_PASSWORD=mytheus_admin
REDIS_URL=redis://localhost:6390/0
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8085

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mytheus

# Clerk / Stripe / LiveKit — fill with test-mode keys as needed for the feature you are running.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

PUBLIC_HOSTNAME=:80

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
